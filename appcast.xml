        <item>
            <title>0.5.0</title>
            <pubDate>Fri, 31 Jul 2026 10:20:16 +0800</pubDate>
            <link>https://github.com/longhaiqwe/PinSnip/releases/tag/v0.5.0</link>
            <sparkle:fullReleaseNotesLink>https://github.com/longhaiqwe/PinSnip/releases/tag/v0.5.0</sparkle:fullReleaseNotesLink>
