            <link>https://github.com/longhaiqwe/PinSnip/releases/tag/v0.7.0</link>
            <sparkle:fullReleaseNotesLink>https://github.com/longhaiqwe/PinSnip/releases/tag/v0.7.0</sparkle:fullReleaseNotesLink>
